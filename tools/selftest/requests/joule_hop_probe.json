    {"t": 2.2, "kind": "snap", "label": "joule_walk_3"},
    {"t": 2.3, "kind": "snap", "label": "joule_walk_4"},
    {"t": 2.4, "kind": "snap", "label": "joule_walk_5"},
    {"t": 2.5, "kind": "snap", "label": "joule_walk_6"},
