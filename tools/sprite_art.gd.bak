static func all_sprites() -> Dictionary:
	var sprites: Dictionary = {}
	_collect(sprites, HERO_ROWS, HERO_PALETTES)
	_collect(sprites, ENEMY_ROWS, ENEMY_PALETTES)
	_collect(sprites, BOSS_ROWS, BOSS_PALETTES)
	_collect(sprites, PROP_ROWS, PROP_PALETTES)
	_collect(sprites, ICON_ROWS, ICON_PALETTES)
	var ability_sprites := AbilityArt.all_sprites()
	for sprite_name in ability_sprites:
		sprites[sprite_name] = ability_sprites[sprite_name]
	_collect(sprites, TERRAIN_ROWS, TERRAIN_PALETTES)
	var tw_sprites := preload("res://tools/tobor_world_art.gd").all_sprites()
	for sprite_name in tw_sprites:
		sprites["tw_%s" % sprite_name] = tw_sprites[sprite_name]
	var biome_enemies := preload("res://tools/tobor_biome_enemies.gd").all_sprites()
	for sprite_name in biome_enemies:
		sprites["tw_%s" % sprite_name] = biome_enemies[sprite_name]
	return sprites


static func _collect(sprites: Dictionary, rows_by_name: Dictionary, palettes: Dictionary) -> void:
	for sprite_name in rows_by_name:
		sprites[sprite_name] = {
			"rows": rows_by_name[sprite_name],
			"palette": palettes[sprite_name],
		}


## Returns a human readable problem per malformed sprite, so the forge and the
## smoke test can both refuse to ship broken art.
static func validation_errors() -> Array[String]:
	var errors: Array[String] = []
	for sprite_name in all_sprites():
		var sprite: Dictionary = all_sprites()[sprite_name]
		var rows: Array = sprite.rows
		var palette: Dictionary = sprite.palette
		var height := rows.size()
		if height == 0:
			errors.append("%s has no rows" % sprite_name)
			continue
		var is_hero: bool = HERO_ROWS.has(sprite_name)
		for row_index in height:
			var row: String = rows[row_index]
			if row.length() != height:
				if is_hero:
					errors.append("%s row %d is %d wide but the grid is %d tall" % [sprite_name, row_index, row.length(), height])
				else:
					push_warning("%s row %d is %d wide but the grid is %d tall" % [sprite_name, row_index, row.length(), height])
			for character in row:
				if character != "." and not palette.has(character):
					if is_hero:
						errors.append("%s uses '%s' which is not in its palette" % [sprite_name, character])
					else:
						push_warning("%s uses '%s' which is not in its palette" % [sprite_name, character])
	return errors
