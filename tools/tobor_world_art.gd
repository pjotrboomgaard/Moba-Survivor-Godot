		sprites["%s_dirt_tile" % biome] = {"rows": dirts[biome], "palette": _tone_ground(BIOME_TILE_PALETTES[biome])}
		sprites["%s_lava_chunk" % biome] = {"rows": TERRAIN_ROWS.lava_chunk, "palette": _tone_terrain(BIOME_ROCK_PALETTES[biome])}
		sprites["%s_ice_crystal" % biome] = {"rows": TERRAIN_ROWS.ice_crystal, "palette": _tone_terrain(BIOME_ROCK_PALETTES[biome])}
		sprites["%s_crate_box" % biome] = {"rows": TERRAIN_ROWS.crate_box, "palette": _tone_terrain(BIOME_ROCK_PALETTES[biome])}
