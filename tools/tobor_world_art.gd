		sprites["%s_tree_pine" % biome] = {"rows": TERRAIN_ROWS.tree_pine if biome != "ice" else _ICE_TREE, "palette": _tone_terrain(BIOME_TREE_PALETTES[biome])}
		sprites["%s_tree_dead" % biome] = {"rows": TERRAIN_ROWS.tree_dead, "palette": _tone_terrain(BIOME_TREE_PALETTES[biome])}
		sprites["%s_tree_pipe" % biome] = {"rows": TERRAIN_ROWS.tree_pipe if biome != "factory" else _FACTORY_TREE, "palette": _tone_terrain(BIOME_TREE_PALETTES[biome])}
		sprites["%s_tree_piling" % biome] = {"rows": TERRAIN_ROWS.tree_piling if biome != "docks" else _DOCKS_TREE, "palette": _tone_terrain(BIOME_TREE_PALETTES[biome])}
		sprites["%s_tree_willow" % biome] = {"rows": TERRAIN_ROWS.tree_willow, "palette": _tone_terrain(BIOME_TREE_PALETTES[biome])}
		sprites["%s_tree_round" % biome] = {"rows": TERRAIN_ROWS.tree_round, "palette": _tone_terrain(BIOME_TREE_PALETTES[biome])}
		sprites["%s_tree_fir" % biome] = {"rows": TERRAIN_ROWS.tree_fir, "palette": _tone_terrain(BIOME_TREE_PALETTES[biome])}
		sprites["%s_tree_palm" % biome] = {"rows": TERRAIN_ROWS.tree_palm, "palette": _tone_terrain(BIOME_TREE_PALETTES[biome])}
		sprites["%s_tree_cypress" % biome] = {"rows": TERRAIN_ROWS.tree_cypress, "palette": _tone_terrain(BIOME_TREE_PALETTES[biome])}
		sprites["%s_tree_maple" % biome] = {"rows": TERRAIN_ROWS.tree_maple, "palette": _tone_terrain(BIOME_TREE_PALETTES[biome])}
		sprites["%s_rock_small" % biome] = {"rows": rocks[biome], "palette": _tone_terrain(BIOME_ROCK_PALETTES[biome])}
		sprites["%s_rock_large" % biome] = {"rows": TERRAIN_ROWS.rock_large, "palette": _tone_terrain(BIOME_ROCK_PALETTES[biome])}
		sprites["%s_rock_jagged" % biome] = {"rows": TERRAIN_ROWS.rock_jagged, "palette": _tone_terrain(BIOME_ROCK_PALETTES[biome])}
		sprites["%s_boulder" % biome] = {"rows": TERRAIN_ROWS.boulder, "palette": _tone_terrain(BIOME_ROCK_PALETTES[biome])}
		sprites["%s_spire" % biome] = {"rows": TERRAIN_ROWS.spire, "palette": _tone_terrain(BIOME_ROCK_PALETTES[biome])}
	# Town buildings: shared across all biomes (not biome-toned). These are baked
	# pixel-art PNGs in assets/sprites/ (see tools/generate_town.py) — they are NOT
	# rows/palette here; this just registers the sprite ids so the forge bakes the
	# tw_<biome>_town_* variants if desired. The arena places the base town_*.png
	# directly for the docks biome.
		if biome == "docks":
			sprites["town_house"] = {"rows": _TOWN_HOUSE_ROWS, "palette": _TOWN_HOUSE_PALETTE}
			sprites["town_shop"] = {"rows": _TOWN_SHOP_ROWS, "palette": _TOWN_SHOP_PALETTE}
			sprites["town_church"] = {"rows": _TOWN_CHURCH_ROWS, "palette": _TOWN_CHURCH_PALETTE}
			sprites["town_well"] = {"rows": _TOWN_WELL_ROWS, "palette": _TOWN_WELL_PALETTE}
	return sprites


## Desaturate + lighten a biome terrain palette toward the old grass-meadow tone.
## Pure palette transform — no sprite/rows touched. TERRAIN_SAT_ADJUST is the knob.
## Public so the forge can route the untoned classic terrain through the same path.
static func tone_terrain_palette(palette: Dictionary, sat_scale: float = TERRAIN_SAT_ADJUST) -> Dictionary:
	var tweaked: Dictionary = {}
	for key in palette:
		var color := Color(str(palette[key]))
		var gray := color.get_luminance()
		color.s = clampf(color.s * sat_scale, 0.0, 1.0)
		color.v = clampf(lerpf(color.v, gray, TERRAIN_LIGHT_ADJUST), 0.0, 1.0)
		tweaked[key] = color.to_html(false)
	return tweaked


static func _tone_terrain(palette: Dictionary) -> Dictionary:
	return tone_terrain_palette(palette)


static func _tone_ground(palette: Dictionary) -> Dictionary:
	return tone_terrain_palette(palette, GROUND_SAT_ADJUST)


static func _collect(sprites: Dictionary, rows_by_name: Dictionary, palettes: Dictionary) -> void:
	for sprite_name in rows_by_name:
		sprites[sprite_name] = {
			"rows": rows_by_name[sprite_name],
			"palette": palettes[sprite_name],
		}
