func _on_loadout_slot_pressed(slot_index: int) -> void:
	var hero_id := PlayerProfile.selected_class_id
	var loadout := PlayerProfile.loadout_for(hero_id)
	# Ultimate slot only accepts the hero's true ultimate and only once unlocked.
	if slot_index == 3:
		if not PlayerProfile.is_ult_unlocked(hero_id):
			return
		var kit := PlayerClass.kit_ability_ids(hero_id)
		var ult := String(kit[2]) if kit.size() > 2 else ""
		PlayerProfile.set_loadout_slot(hero_id, 3, ult)
		AudioService.play("ui_click")
		_refresh_loadout_panel()
		return
	# Regular slots cycle through the hero's known (kit + banked) regular abilities.
	var options: Array[String] = []
	for aid in PlayerProfile.known_abilities_for(hero_id):
		var kit_all := PlayerClass.kit_ability_ids(hero_id)
		if kit_all.size() > 2 and aid == kit_all[2]:
			continue  # hero ult lives in slot 4
		if not options.has(aid):
			options.append(aid)
	if options.is_empty():
		return
	var current := loadout[slot_index]
	var at := options.find(current)
	var next := options[(at + 1) % options.size()]
	PlayerProfile.set_loadout_slot(hero_id, slot_index, next)
	AudioService.play("ui_click")
	_refresh_loadout_panel()


