var team_claim_row: HBoxContainer
var team_claim_buttons: Dictionary = {}  # team_id -> Button


## Row of four team chips shown in Rift Clash network lobbies. Each button claims the
## corner for the local peer on the host and Piggy-backs on `server_claim_team`; the
## host-side `lobby_team_claims` map then drives `RiftClashManager.assign_teams`.
func _build_team_claim_row() -> void:
	if team_claim_row != null:
		return
	team_claim_row = HBoxContainer.new()
	team_claim_row.name = "TeamClaimRow"
	team_claim_row.visible = false
	team_claim_row.add_theme_constant_override("separation", 6)
	var label := Label.new()
	label.text = "Your team:"
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	team_claim_row.add_child(label)
	for team_index in RiftClashManager.TEAM_KEYS.size():
		var team_id: String = RiftClashManager.TEAM_KEYS[team_index]
		var button := Button.new()
		button.name = "TeamButton_%s" % team_id.capitalize()
		button.toggle_mode = true
		button.custom_minimum_size = Vector2(0, 36)
		button.text = str(RiftClashManager.TEAM_NAMES[team_id])
		button.add_theme_color_override("font_color", RiftClashManager.TEAM_COLORS[team_id])
		button.pressed.connect(_on_team_claim_pressed.bind(team_id))
		team_claim_buttons[team_id] = button
		team_claim_row.add_child(button)
	var layout := player_slots.get_parent()
	if layout != null and layout is VBoxContainer:
		(layout as VBoxContainer).add_child(team_claim_row)
		(layout as VBoxContainer).move_child(team_claim_row, player_slots.get_index())


func _on_team_claim_pressed(team_id: String) -> void:
	AudioService.play("ui_click")
	for other_id in team_claim_buttons.keys():
		(team_claim_buttons[other_id] as Button).button_pressed = other_id == team_id
	var my_peer := multiplayer.get_unique_id()
	lobby_team_claims[my_peer] = team_id
	# Hosts apply their own pick locally; only remote peers push through the RPC.
	if _is_lobby_host:
		server_claim_team(team_id)
	else:
		server_claim_team.rpc_id(1, team_id)
	_refresh_player_slots()


func _sync_team_claim_ui() -> void:
